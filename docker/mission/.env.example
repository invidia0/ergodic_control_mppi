# This drone's heartbeat drone_id (mullet_core's drone_id; empty there means uav_<instance>).
DRONE_ID=uav_0
# Must match mullet_core's container (mullet_ros_base/.env on the drone).
ROS_DOMAIN_ID=0
# px4_msgs branch matching the PX4 firmware. The SITL image runs PX4 v1.16.
PX4_MSGS_REF=release/1.17
